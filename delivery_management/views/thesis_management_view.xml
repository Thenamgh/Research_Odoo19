<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Thesis List -->
        <record id="view_thesis_project_list" model="ir.ui.view">
            <field name="name">thesis.project.list</field>
            <field name="model">thesis.project</field>
            <field name="arch" type="xml">
                <list string="Danh sách hồ sơ đồ án">
                    <field name="batch_id"/>
                    <field name="class_id"/>
                    <field name="student_code"/>
                    <field name="student_id"/>
                    <field name="title"/>
                    <field name="supervisor_id"/>
                    <field name="lecturer_code"/>
                    <field name="status"/>
                </list>
            </field>
        </record>

        <!-- Thesis Form -->
        <record id="view_thesis_project_form" model="ir.ui.view">
            <field name="name">thesis.project.form</field>
            <field name="model">thesis.project</field>
            <field name="arch" type="xml">
                <form string="Thesis Project">
                    <header>
                        <!-- Bước 2: Đăng ký đề tài -->
                        <button name="action_register" type="object" string="Xác nhận đăng ký" class="btn-primary" invisible="status != 'draft'" />

                        <!-- Bước 3: Giao đề tài và phân công GVHD -->
                        <button name="action_assign" type="object" string="Giao đề tài" class="btn-primary" invisible="status != 'registered'" />

                        <!-- Bước 4: Sinh viên xác nhận nhận đề tài -->
                        <button name="action_accept" type="object" string="Xác nhận đã nhận" class="btn-primary" invisible="status != 'assigned'" />

                        <!-- Bước 5: Thực hiện đồ án -->
                        <button name="action_start" type="object" string="Bắt đầu thực hiện" class="btn-primary" invisible="status != 'accepted'" />

                        <!-- Bước 6: Nộp đồ án -->
                        <button name="action_submit" type="object" string="Xác nhận nộp" class="btn-primary" invisible="status != 'in_progress'" />

                        <!-- Bước 7: GVHD và phản biện đánh giá -->
                        <button name="action_start_review" type="object" string="Chuyển đánh giá" class="btn-primary" invisible="status != 'submitted'" />

                        <!-- Bước 8: Đủ điều kiện bảo vệ -->
                        <button name="action_approve_defense" type="object" string="Duyệt bảo vệ" class="btn-primary" invisible="status != 'reviewing'" />

                        <!-- Bước 9: Bảo vệ đồ án -->
                        <button name="action_defend" type="object" string="Xác nhận đã bảo vệ" class="btn-primary" invisible="status != 'defense_approved'" />

                        <!-- Bước 10: Xét tốt nghiệp -->
                        <button name="action_start_graduation_review" type="object" string="Chuyển xét tốt nghiệp" class="btn-primary" invisible="status != 'defended'" />

                        <!-- Bước 11: Hoàn thành -->
                        <button name="action_complete" type="object" string="Hoàn thành" class="btn-primary" invisible="status != 'graduation_review'" />

                        <!-- Nhánh hủy hồ sơ -->
                        <button name="action_cancel" type="object" string="Hủy hồ sơ" confirm="Thầy có chắc chắn muốn hủy hồ sơ này?" invisible="status in ['cancelled', 'completed']" />

                        <field name="status" widget="statusbar" statusbar_visible="draft,registered,assigned,accepted,in_progress,submitted,reviewing,defense_approved,defended,graduation_review,completed" />
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="code" readonly="1"/>
                                <field name="batch_id"/>
                                <field name="title"/>
                            </group>

                            <group>
                                <field name="student_id"/>
                                <field name="student_phone" readonly="1"/>
                                <field name="student_email" readonly="1"/>
                            </group>

                            <group>
                                <field name="supervisor_id"/>
                                <field name="assigned_by" readonly="1"/>
                                <field name="created_date" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Timeline">
                                <group>
                                    <field name="start_date"/>
                                    <field name="due_date"/>
                                    <field name="submission_date"/>
                                    <field name="defense_date"/>
                                </group>
                            </page>

                            <page string="Files &amp; Grade">
                                <group>
                                    <field name="attachment" filename="attachment_name"/>
                                    <field name="attachment_name"/>
                                    <field name="grade"/>
                                </group>
                            </page>

                            <page string="Notes">
                                <field name="notes" colspan="4"/>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>
        <filter name="unassigned" string="Chưa phân công GVHD" domain="[
        ('supervisor_id', '=', False),
        ('status', 'not in', ['completed', 'cancelled'])
    ]" />

        <group expand="0" string="Nhóm theo">
            <filter name="group_by_batch" string="Đợt đồ án" context="{'group_by': 'batch_id'}" />

            <filter name="group_by_class" string="Lớp" context="{'group_by': 'class_id'}" />

            <filter name="group_by_supervisor" string="Giảng viên hướng dẫn" context="{'group_by': 'supervisor_id'}" />

            <filter name="group_by_status" string="Trạng thái quy trình" context="{'group_by': 'status'}" />
        </group>
        <!-- Search -->
        <record id="view_thesis_project_search" model="ir.ui.view">
            <field name="name">thesis.project.search</field>
            <field name="model">thesis.project</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="batch_id"/>
                    <field name="title"/>
                    <field name="student_id"/>
                    <field name="supervisor_id"/>
                    <field name="status"/>

                    <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
                    <filter string="Assigned" name="assigned" domain="[('status','=','assigned')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('status','=','in_progress')]"/>
                    <filter string="Submitted" name="submitted" domain="[('status','=','submitted')]"/>
                    <filter string="Defended" name="defended" domain="[('status','=','defended')]"/>
                    <filter string="Completed" name="completed" domain="[('status','=','completed')]"/>
                </search>
            </field>
        </record>

        <!-- ================================================== -->
        <!-- ACTIONS QUẢN LÝ HỒ SƠ ĐỒ ÁN                         -->
        <!-- ================================================== -->

        <!-- Tất cả hồ sơ đồ án -->
        <record id="action_thesis_project" model="ir.actions.act_window">
            <field name="name">Tất cả hồ sơ đồ án</field>
            <field name="res_model">thesis.project</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Phân công theo lớp -->
        <record id="action_thesis_project_by_class" model="ir.actions.act_window">
            <field name="name">Phân công theo lớp</field>
            <field name="res_model">thesis.project</field>
            <field name="view_mode">list,form</field>
            <field name="context">
                {
                    'search_default_group_by_class': 1
                }
            </field>
        </record>

        <!-- Phân công theo giảng viên -->
        <record id="action_thesis_project_by_supervisor" model="ir.actions.act_window">
            <field name="name">Phân công theo giảng viên</field>
            <field name="res_model">thesis.project</field>
            <field name="view_mode">list,form</field>
            <field name="context">
                {
                    'search_default_group_by_supervisor': 1
                }
            </field>
        </record>

        <!-- Hồ sơ chưa có giảng viên hướng dẫn -->
        <record id="action_thesis_project_unassigned" model="ir.actions.act_window">
            <field name="name">Chưa phân công GVHD</field>
            <field name="res_model">thesis.project</field>
            <field name="view_mode">list,form</field>
            <field name="domain">
                [
                    ('supervisor_id', '=', False),
                    ('status', 'not in', ['completed', 'cancelled'])
                ]
            </field>
        </record>

        <!-- Theo dõi toàn bộ quy trình -->
        <record id="action_thesis_project_by_status" model="ir.actions.act_window">
            <field name="name">Theo dõi quy trình 11 bước</field>
            <field name="res_model">thesis.project</field>
            <field name="view_mode">list,form</field>
            <field name="context">
                {
                    'search_default_group_by_status': 1
                }
            </field>
        </record>


        <!-- ================================================== -->
        <!-- MENU QUẢN LÝ VÀ PHÂN CÔNG                           -->
        <!-- ================================================== -->

        <menuitem id="menu_thesis_management" name="Quản lý đồ án" parent="menu_delivery_management" sequence="20" />

        <menuitem id="menu_thesis_list" name="Tất cả hồ sơ" parent="menu_thesis_management" action="action_thesis_project" sequence="10" />

        <menuitem id="menu_thesis_by_class" name="Phân công theo lớp" parent="menu_thesis_management" action="action_thesis_project_by_class" sequence="20" />

        <menuitem id="menu_thesis_by_supervisor" name="Phân công theo giảng viên" parent="menu_thesis_management" action="action_thesis_project_by_supervisor" sequence="30" />

        <menuitem id="menu_thesis_unassigned" name="Chưa phân công GVHD" parent="menu_thesis_management" action="action_thesis_project_unassigned" sequence="40" />

        <menuitem id="menu_thesis_by_status" name="Theo dõi quy trình 11 bước" parent="menu_thesis_management" action="action_thesis_project_by_status" sequence="50" />
    </data>
</odoo>